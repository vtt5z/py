rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if owns(userId) && request.resource.data.uid == userId;
      allow read, update, delete: if owns(userId);

      match /{document=**} {
        allow read, write: if owns(userId);
      }
    }

    match /chats/{userId} {
      allow read, write: if owns(userId);

      match /threads/{chatId} {
        allow read, write: if owns(userId);
      }

      match /messages/{messageId} {
        allow read, write: if owns(userId);
      }

      match /{document=**} {
        allow read, write: if owns(userId);
      }
    }

    match /uploads/{uploadId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
